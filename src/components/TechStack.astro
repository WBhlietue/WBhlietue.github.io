---
import { SITE } from '../consts';

const all = SITE.techStack.flatMap((group) => group.items);
const palettes = [
  ['--p1', '--p3'],
  ['--p2', '--p5'],
  ['--p4', '--p2'],
  ['--p5', '--p4'],
  ['--p3', '--p1'],
  ['--p2', '--p4'],
  ['--p1', '--p4'],
];
---

<section id="stack" class="section" aria-labelledby="stack-title">
  <div class="container">
    <p class="eyebrow">Stack</p>
    <h2 class="section-title reveal" id="stack-title">Tools I reach for</h2>
    <p class="lead reveal-blur" style="--i:1">
      The languages and platforms I actually ship with — game engines, web runtimes and everything
      in between.
    </p>
  </div>

  <div class="framed reveal-blur" aria-hidden="true">
    <div class="marquee">
      <div class="marquee-track">
        {[0, 1, 2].map(() => all.map((item) => <span class="pill">{item}</span>))}
      </div>
    </div>
  </div>

  <div class="container">
    <div class="grid">
      {
        SITE.techStack.map((group, i) => (
          <article class="card tcard reveal-pop" style={`--i:${i}; --c1: var(${palettes[i][0]}); --c2: var(${palettes[i][1]})`}>
            <h3>{group.group}</h3>
            <ul class="chips">
              {group.items.map((item) => (
                <li class="chip">{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .framed {
    margin-block: var(--space-lg);
    padding-block: var(--space-sm);
    border-block: 1px solid var(--line);
    background: linear-gradient(90deg, rgb(255 255 255 / 0%), rgb(255 255 255 / 70%) 20%, rgb(255 255 255 / 70%) 80%, rgb(255 255 255 / 0%));
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  .marquee-track {
    gap: var(--space-sm);
    padding-inline: var(--space-sm);
  }

  .pill {
    flex: none;
    padding: 0.36rem 1rem;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 88%);
    color: var(--ink-2);
    font-size: var(--step-0);
    font-weight: 700;
    letter-spacing: -0.01em;
    box-shadow: var(--shadow-1);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }

  .tcard {
    overflow: hidden;
  }

  .tcard h3 {
    position: relative;
    margin-bottom: var(--space-sm);
    font-size: var(--step-0);
    letter-spacing: 0;
  }

  .tcard h3::after {
    content: '';
    display: block;
    width: 40px;
    height: 4px;
    margin-top: 0.55rem;
    border-radius: 4px;
    background-image: linear-gradient(90deg, var(--c1), var(--c2));
    transform-origin: 0 50%;
    animation: underline 0.9s var(--ease) 0.2s both;
  }

  .tcard::after {
    content: '';
    position: absolute;
    top: -40px;
    right: -40px;
    width: 130px;
    height: 130px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--c1), transparent 70%);
    opacity: 0.18;
    pointer-events: none;
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease);
  }

  .tcard:hover::after {
    opacity: 0.32;
    transform: scale(1.12);
  }

  .chips {
    position: relative;
    z-index: 1;
  }
</style>
