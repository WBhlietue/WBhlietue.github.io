---
import { SITE } from '../consts';

const letters = [...SITE.username];
const words = SITE.subtagline.split(' ');
---

<section id="home" class="hero" aria-labelledby="hero-title">
  <span class="orb orb-a" aria-hidden="true"></span>
  <span class="orb orb-b" aria-hidden="true"></span>
  <span class="grid" aria-hidden="true"></span>

  <div class="container inner">
    <p class="status rise" style="--i:0">
      <span class="dot" aria-hidden="true"></span>
      {SITE.tagline}
    </p>

    <h1 id="hero-title" aria-label={SITE.username}>
      {
        letters.map((ch, i) => (
          <span class="letter" aria-hidden="true" style={`--i:${i}`}>{ch}</span>
        ))
      }
      <span class="bar" aria-hidden="true"></span>
    </h1>
    <span class="blob" aria-hidden="true"></span>

    <p class="lead rise" style="--i:1">
      {words.map((w, i) => <span class="word" style={`--i:${i}`}>{w}&nbsp;</span>)}
    </p>

    <ul class="roles rise" style="--i:2">
      {SITE.roles.map((role) => <li>{role}</li>)}
    </ul>

    <div class="btn-row rise" style="--i:3">
      <a class="btn" href="#work">View Work</a>
      <a class="btn btn-ghost" href={SITE.github} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.5 2 2 6.6 2 12.3c0 4.5 2.9 8.4 6.8 9.7.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.4-3.4-1.4-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.6 1.1 1.6 1.1.9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.7-1.4-2.2-.3-4.6-1.1-4.6-5.1 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.7 1a9.3 9.3 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 4-2.4 4.8-4.6 5.1.4.3.7 1 .7 2v3c0 .3.2.6.7.5A10.3 10.3 0 0 0 22 12.3C22 6.6 17.5 2 12 2Z" />
        </svg>
        GitHub
      </a>
      <a class="btn btn-ghost" href={SITE.blogUrl}>Blog</a>
    </div>

    <p class="mail rise" style="--i:4">
      <span class="mail-label">Email</span>
      <span class="mail-value">{SITE.email}</span>
    </p>

    <a class="hint rise" href="#about" style="--i:5">
      <span>Scroll</span>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 9l6 6 6-6" />
      </svg>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(94vh, 860px);
    padding-block: var(--space-2xl) var(--space-xl);
    overflow: hidden;
    scroll-margin-top: var(--nav-h);
  }

  .inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .orb {
    position: absolute;
    z-index: 0;
    border-radius: 50%;
    filter: blur(64px);
    pointer-events: none;
    animation: float 18s ease-in-out infinite alternate;
  }

  .orb-a {
    top: -40px;
    right: 4%;
    width: min(52vw, 460px);
    aspect-ratio: 1;
    background: conic-gradient(from 120deg, var(--p1), var(--p3), var(--p4), var(--p1));
    opacity: 0.28;
  }

  .orb-b {
    bottom: -80px;
    left: -6%;
    width: min(46vw, 380px);
    aspect-ratio: 1;
    background: conic-gradient(from 300deg, var(--p2), var(--p5), var(--p1), var(--p2));
    opacity: 0.22;
    animation-duration: 24s;
    animation-direction: alternate-reverse;
  }

  .grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: linear-gradient(var(--line-2) 1px, transparent 1px),
      linear-gradient(90deg, var(--line-2) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: radial-gradient(70% 60% at 50% 40%, #000 10%, transparent 78%);
    -webkit-mask-image: radial-gradient(70% 60% at 50% 40%, #000 10%, transparent 78%);
    opacity: 0.6;
    pointer-events: none;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.34rem 0.95rem 0.34rem 0.75rem;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 78%);
    box-shadow: var(--shadow-1);
    color: var(--ink-2);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.04em;
    backdrop-filter: blur(8px);
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--grad);
    animation: pulse 2.2s ease-in-out infinite;
  }

  h1 {
    display: flex;
    flex-wrap: wrap;
    max-width: 18ch;
    margin-block: var(--space-2xs);
    line-height: 0.98;
  }

  .letter {
    display: inline-block;
    background-image: linear-gradient(112deg, var(--p1), var(--p2) 34%, var(--p3) 60%, var(--p4) 90%, var(--p1));
    background-size: 240% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    color: var(--p1);
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 14px 30px var(--glow-a));
    animation: shimmer 12s linear infinite, fade-up 0.9s var(--ease) both;
    animation-delay: 0s, calc(0.12s + var(--i) * 55ms);
    padding: 0.1rem;
  }

  .bar {
    display: block;
    width: 100%;
    max-width: 320px;
    height: 8px;
    margin-top: 0.55rem;
    border-radius: 999px;
    background-image: var(--grad);
    transform-origin: 0 50%;
    animation: underline 0.9s var(--ease) 0.75s both;
    box-shadow: 0 6px 20px -4px var(--glow-a);
  }

  .blob {
    position: absolute;
    top: 40%;
    left: -140px;
    width: 420px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: conic-gradient(from 200deg, var(--p2), var(--p4), var(--p5), var(--p1), var(--p2));
    opacity: 0.16;
    filter: blur(58px);
    pointer-events: none;
    animation: spin 40s linear infinite;
  }

  .lead {
    max-width: 54ch;
    color: var(--ink-2);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .word {
    display: inline-block;
    animation: rise-in 0.8s var(--ease) both;
    animation-delay: calc(0.5s + var(--i) * 45ms);
  }

  .roles {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .roles li {
    padding: 0.26rem 0.78rem;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-pill);
    background: linear-gradient(135deg, #f6f1ff, #edf4ff 55%, #fff0f4);
    color: var(--p1);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .rise {
    animation: rise-in 0.85s var(--ease) both;
    animation-delay: calc(0.75s + var(--i) * 90ms);
  }

  .hint {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: var(--space-md);
    color: var(--muted);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .mail {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.34rem 0.85rem;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 78%);
    box-shadow: var(--shadow-1);
    backdrop-filter: blur(8px);
  }

  .mail-label {
    color: var(--muted);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .mail-value {
    font: 600 var(--step-0) / 1.4 var(--mono);
    letter-spacing: -0.01em;
    background-image: linear-gradient(96deg, var(--p1), var(--p2) 55%, var(--p3));
    background-clip: text;
    -webkit-background-clip: text;
    color: var(--p1);
    -webkit-text-fill-color: transparent;
    user-select: all;
  }

  .hint svg {
    animation: nudge 1.8s ease-in-out infinite;
  }

  .hint:hover {
    color: var(--p1);
  }
</style>
